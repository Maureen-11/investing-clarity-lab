{
  "name": "investing-clarity-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "node scripts/build-mainland.mjs --base-path=/investing-clarity-lab",
    "build:mainland": "node scripts/build-mainland.mjs",
    "preview:pages": "node scripts/serve-pages.mjs",
    "data:update": "node scripts/build_macro_history.mjs && npm run data:update:all",
    "data:update:macro": "node scripts/build_macro_history.mjs",
    "data:update:market": "node scripts/build_etf_history.mjs && node scripts/build_etf_pack.mjs && node scripts/validate_etf_pack.mjs",
    "data:update:all": "node scripts/build_etf_history.mjs && node scripts/build_product_metadata.mjs && node scripts/build_etf_pack.mjs && node scripts/validate_etf_pack.mjs",
    "data:update:metadata": "node scripts/build_product_metadata.mjs",
    "data:etf-pack": "node scripts/build_etf_pack.mjs",
    "data:validate": "node scripts/validate_etf_pack.mjs",
    "start": "vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.7",
    "vite": "8.0.16",
    "wrangler": "4.124.0"
  },
  "type": "module"
}
